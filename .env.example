# ---- Claude (console.anthropic.com -> API keys; needs credit) -----------------
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium          # low = cheaper/faster, high = more careful
# HISTORY_TURNS=30              # how many past messages Claude sees per customer

# ---- Kapso (app.kapso.ai -> API keys; webhook secret from the phone number's webhook) --
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=

# ---- Escalation email ----------------------------------------------------------
ESCALATION_EMAIL=team@greaterinside.com
# Any SMTP works: Google Workspace (smtp.gmail.com:587 + app password), Amazon SES, Resend, Postmark...
# Leave SMTP_HOST empty to only log escalations to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Greater Inside WhatsApp Bot <bot@greaterinside.com>"

# ---- Human takeover --------------------------------------------------------------
# Numbers (with country code, comma-separated) allowed to send /pause, /resume, /status to the bot
ADMIN_PHONES=
# Bearer token for the /admin HTTP endpoints (pick a long random string)
ADMIN_TOKEN=

# ---- Runtime ---------------------------------------------------------------------
PORT=3000
DATA_DIR=data
# KNOWLEDGE_PATH=knowledge.md
