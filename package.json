{
  "name": "greater-inside-whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Greater Inside WhatsApp sales & support agent (Kapso + Claude)",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "chat": "tsx --env-file=.env src/chat.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@kapso/whatsapp-cloud-api": "^0.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/functions": "^3.9.11",
    "nodemailer": "^10.0.16",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2"
  }
}
